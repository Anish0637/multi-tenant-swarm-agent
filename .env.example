# Application Settings
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# OpenAI/LLM
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
ECR_REGISTRY=your_account_id.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY=multi-tenant-swarm-agent

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/swarm_agent
REDIS_URL=redis://localhost:6379/0

# MCP Server
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000

# Registry Service
REGISTRY_HOST=localhost
REGISTRY_PORT=8001

# Security
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

# Agent Configuration
SUPERVISOR_AGENT_NAME=supervisor
HR_AGENT_NAME=hr_agent
FINANCE_AGENT_NAME=finance_agent
MEDICAL_AGENT_NAME=medical_agent

# Multi-tenancy
DEFAULT_TENANT=default
TENANT_ISOLATION=true

# Monitoring
ENABLE_TRACING=true
TRACE_SAMPLE_RATE=1.0
ENABLE_METRICS=true

# Features
ENABLE_RBAC=true
ENABLE_ABAC=true
ENABLE_CBAC=true
